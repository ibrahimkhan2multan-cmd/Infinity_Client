<?xml version="1.0" encoding="utf-8"?><androidx.constraintlayout.widget.ConstraintLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="#080B18">

<ScrollView
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:fillViewport="true"
    android:overScrollMode="never"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingTop="38dp"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INFINITY"
            android:textColor="#A78BFA"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.32" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="INFINITY'S CLIENT"
            android:textColor="#FFFFFF"
            android:textSize="29sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="YOUR WORLD. YOUR RULES."
            android:textColor="#929BB8"
            android:textSize="12sp"
            android:letterSpacing="0.16" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#12182A">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MINECRAFT BEDROCK"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Target version: 1.26.33.1"
                android:textColor="#A78BFA"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Launcher setup in progress. Your existing game and worlds stay separate."
                android:textColor="#929BB8"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="12dp"
            android:text="MAIN MENU"
            android:textColor="#929BB8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.18" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlay"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="PLAY"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#7653E8"
            app:cornerRadius="14dp"
            app:icon="@android:drawable/ic_media_play"
            app:iconTint="#FFFFFF"
            app:iconGravity="textStart"
            app:iconPadding="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClientMenu"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="CLIENT MENU"
            android:textColor="#E5E7FF"
            android:textSize="14sp"
            app:backgroundTint="#12182A"
            app:cornerRadius="14dp"
            app:strokeColor="#51417D"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHudEditor"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="HUD EDITOR"
            android:textColor="#E5E7FF"
            android:textSize="14sp"
            app:backgroundTint="#12182A"
            app:cornerRadius="14dp"
            app:strokeColor="#51417D"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettings"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="SETTINGS"
            android:textColor="#E5E7FF"
            android:textSize="14sp"
            app:backgroundTint="#12182A"
            app:cornerRadius="14dp"
            app:strokeColor="#51417D"
            app:strokeWidth="1dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="INFINITY'S CLIENT  •  ANDROID"
            android:textColor="#626C8B"
            android:textSize="10sp"
            android:letterSpacing="0.08" />

    </LinearLayout>

</ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
